[gd_scene format=3 uid="uid://1jrmtml7pxx1"]

[sub_resource type="GDScript" id="GDScript_y32ns"]
script/source = "extends Control

func _on_button_pressed() -> void:
	GoogleAuthManager.begin_authentication()
	GoogleAuthManager.server_stopped.connect(
		func(success: bool): 
			if(!success): return
			_update_label()
	)

func _update_label() -> void:
	var res = await ApiClient.request(
		HTTPClient.METHOD_GET,
		\"/api/me\",
		\"\",
		[\"Authorization: Bearer %s\" % State.access_token]
	)
	
	if(res.ok):
		$Label.text = \"%s\\n%s\" % [res.data.name, res.data.email]
"

